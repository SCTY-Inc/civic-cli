# All keys are optional. A source without its key is skipped (or reported as an
# error when named with --sources). Run `civic doctor` to check. See SOURCES.md.
GOVINFO_API_KEY=...          # govinfo — https://api.data.gov/signup/
REGULATIONS_GOV_API_KEY=...  # regulations — https://open.gsa.gov/api/regulationsgov/
OPENSTATES_API_KEY=...       # openstates — https://openstates.org/accounts/register/
LEGISCAN_API_KEY=...         # legiscan — https://legiscan.com/legiscan
EXA_API_KEY=...              # exa — https://dashboard.exa.ai/api-keys
CENSUS_API_KEY=...           # census (raises rate limit) — https://api.census.gov/data/key_signup.html
